# ==============================================================================
# VisionPlate AI - Backend Environment Variables
# Safe example values for local development and testing.
# Never commit real secrets to source control.
# ==============================================================================

# Core Application Settings
APP_NAME="VisionPlate AI Backend"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
LOG_LEVEL="INFO"

# Security & Tokens (Development generates an ephemeral key if left empty)
SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL - Credentials managed via environment variables)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="vehicle_alpr"
POSTGRES_USER="alpr_admin"
POSTGRES_PASSWORD=""

# Cache & Queue (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# OAuth Authentication (Google & GitHub)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8000/api/v1/auth/github/callback"

OAUTH_STATE_SECRET=""
