# ==============================================================================
# Multi-Class Vehicle Localization & ALPR Platform - Environment Variables Template
# Copy this file to .env before starting the application locally or in Docker.
# DO NOT COMMIT ACTUAL SECRETS TO GIT.
# ==============================================================================

# Project Metadata
PROJECT_NAME="Vehicle ALPR Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vehicle_alpr
POSTGRES_USER=alpr_admin
POSTGRES_PASSWORD=change_this_secure_password_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Configuration (Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_random_secret_key_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Authentication Providers (OAuth 2.0)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_nextauth_secret_in_production

# Android Application API Base URL (10.0.2.2 for Android Emulator connecting to host localhost)
ANDROID_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Storage Configuration (Local File System / AWS S3 Placeholder)
STORAGE_TYPE=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# AI Inference Pipeline Configuration
AI_MODEL_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.5
AI_OCR_ENGINE=tesseract
AI_WORKER_CONCURRENCY=2
